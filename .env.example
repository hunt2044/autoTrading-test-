# Binance Demo Mode API Credentials
# Get these from demo.binance.com/en/my/settings/api-management
# after enabling Binance Demo Trading on your main Binance account
# Note: env_nested_delimiter="__" means nested fields use double underscore
BINANCE__API_KEY=your_demo_api_key_here
BINANCE__API_SECRET=your_demo_api_secret_here

# Optional: Telegram notifications for WARNING+ level events
# Create a bot via @BotFather, get chat_id from @userinfobot
# TELEGRAM__BOT_TOKEN=your_bot_token_here
# TELEGRAM__CHAT_ID=your_chat_id_here