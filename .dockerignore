# .dockerignore - Exclude unnecessary files from Docker build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# Data (handled by volumes)
data/
*.parquet
*.csv
*.db
*.sqlite

# Logs (handled by volumes)
logs/
*.log

# Results (handled by volumes)
results/

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# Git
.git/
.gitignore

# Documentation
*.md
!README.md

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile*
docker-compose*.yml
compose*.yml
.dockerignore